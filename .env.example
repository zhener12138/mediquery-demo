# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=smart-medicine

# AI (DashScope / Tongyi Qwen)
AI_KEY=sk-your-dashscope-api-key

# Email
EMAIL_SENDER=your-email@qq.com
EMAIL_PASSWORD=your-smtp-authorization-code
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_VALID_MINUTES=5
EMAIL_TITLE=寻药就医系统 - 用户认证
EMAIL_TEMPLATE=您的动态验证码为：<strong style='color: red'>%s</strong>，%d分钟内有效，若非本人操作，请勿泄露。

# Alibaba Cloud OSS
OSS_BUCKET_NAME=your-bucket-name
OSS_END_POINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY=your-oss-access-key
OSS_ACCESS_SECRET=your-oss-access-secret

# JWT
JWT_SECRET=your-jwt-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Default Avatar
DEFAULT_AVATAR_URL=/static/assets/images/default-avatar.svg

# App
SECRET_KEY=your-session-random-secret
DEBUG=false
