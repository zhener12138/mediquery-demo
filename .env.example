# ============================================================
# MediQuery (医问通) 环境变量配置模板
# ============================================================
# 使用方式：cp .env.example .env → 编辑 .env 填入真实值
# ⚠️ .env 文件绝对不能提交到 Git！
# ============================================================

# ============================================================
# MySQL 数据库
# ============================================================
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=mediquery
MYSQL_PORT=3307

# ============================================================
# Spring 数据源（Docker 内部用 mysql 服务名，本地开发用 127.0.0.1）
# ============================================================
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3307/mediquery?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_root_password

# ============================================================
# Redis
# ============================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# ============================================================
# 邮箱配置（用于发送验证码）
# 以 QQ 邮箱为例：
#   1. 登录 mail.qq.com → 设置 → 账户 → POP3/SMTP 服务 → 开启
#   2. 获取授权码（不是 QQ 密码！）
# ============================================================
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_smtp_authorization_code
MAIL_FROM_NAME=医问通 - 用户认证

# ============================================================
# JWT 签名密钥
# 生成方式：openssl rand -base64 64
# ⚠️ 必须是至少 256 位的随机字符串
# ============================================================
JWT_SECRET=change_me_to_a_random_base64_string

# ============================================================
# 阿里云通义千问 (DashScope) — AI 医生功能
# 获取方式：https://dashscope.console.aliyun.com/apiKey
# ============================================================
AI_DASHSCOPE_API_KEY=sk-your_dashscope_api_key

# ============================================================
# 阿里云 OSS（对象存储，用于头像/文件上传）
# 获取方式：https://ram.console.aliyun.com/manage/ak
# ⚠️ 建议使用 RAM 子账号，只授予 OSS 权限
# ============================================================
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=your_aliyun_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
ALIYUN_OSS_BUCKET_NAME=your_bucket_name

# ============================================================
# Flyway 基线版本
# 默认 1：全新空库，从 V1 开始重放全部迁移（推荐）。
# 设成 2：库是 init.sql 时代手工建的、结构已等于 V2
#         （含 duration_desc/severity_scale/history_flags/onset_type 四列），
#         让 Flyway 记一条基线后跳过 V1/V2，不重放建表语句。
# 搞不清楚这个库是什么版本，就先连上去看 consultation 有没有那四列。
# ============================================================
FLYWAY_BASELINE_VERSION=1
