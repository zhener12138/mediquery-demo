<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.mediquery</groupId>
    <artifactId>mediquery-backend</artifactId>
    <version>1.0.0</version>
    <name>MediQuery</name>
    <description>医问通 - 智慧医药查询系统</description>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <jjwt.version>0.12.6</jjwt.version>
        <hutool.version>5.8.34</hutool.version>
        <druid.version>1.2.23</druid.version>
        <dashscope.version>2.16.7</dashscope.version>
        <aliyun-oss.version>3.17.4</aliyun-oss.version>
        <springdoc.version>2.8.6</springdoc.version>
        <h2.version>2.3.232</h2.version>
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!--
          Actuator：只暴露 health 与 info。
          为什么现在才加：阶段一之前项目没有任何“活着还是死了”的探针，
          docker-compose 里 backend 的 healthcheck 只能靠 curl 一个业务接口，
          业务接口挂了（比如数据库连不上）容器还显示 healthy，等于没探。

          暴露范围在 application.yml 的 management.endpoints.web.exposure.include
          里只写 health,info —— 不加 metrics/prometheus/env。
          理由：这些端点会吐出 bean 名、环境变量键、JVM 参数，挂在业务端口上等于送架构图。
          真要做监控应该走独立的运维网络与独立鉴权，而不是顺手开在 8080 上。
          （注：Druid 的 stat-view-servlet 在当前配置里是 enabled: false，不存在重复暴露的问题。）
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Druid -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
            <version>${druid.version}</version>
        </dependency>

        <!-- MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- SpringDoc OpenAPI (Swagger UI) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Hutool -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool.version}</version>
        </dependency>


        <!-- Alibaba DashScope (通义千问) -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>dashscope-sdk-java</artifactId>
            <version>${dashscope.version}</version>
        </dependency>

        <!-- Alibaba OSS -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
            <version>${aliyun-oss.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Dotenv -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <version>4.0.0</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- H2：只用于测试。生产跑 MySQL，测试跑内存库，互不干扰 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              surefire：把 dotenv 挡在测试之外。

              背景：项目有 spring.dotenv.path=./.env，backend/.env 真实存在（开发库密码 +
              真实 API Key）。如果 dotenv 的属性源优先级高于 application-test.yml，
              就会把 H2 换成真实 MySQL，而 schema-h2.sql 第一行是 DROP TABLE。

              实测结论（2026-11-05，替换 backend/.env 后跑探针）：
                dotenv 确实被加载了（探针注入的 PROBE_KEY 能读到），
                但 spring.datasource.url 仍然来自 application-test.yml（H2 mediquery_test），
                dotenv 里的 SPRING_DATASOURCE_URL 没有生效。
              也就是说：当前版本下 profile 特定配置赢过 dotenv，这个风险是理论上的。

              那为什么还留这个 argLine：
              1) 这个优先级顺序是 Spring Boot 内部实现，升级版本可能变，不能赌；
              2) 代价为零，一行配置换掉一整类事故；
              3) 这里写实测结论而不是"肯定会被覆盖"，是为了让接手的人知道依据，
                 而不是照抄一个听起来吓人的理由。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- @{argLine} 是 surefire 的延迟替换：JaCoCo 的 prepare-agent 会在这个属性里
                         注入 -javaagent，这里必须引用它，否则自己写死 argLine 会把 Java agent 挤掉，
                         覆盖率报告出来是全 0 而测试照常绿。 -->
                    <argLine>@{argLine} -Dspring.dotenv.path=./.env.not-used-in-tests -Dspring.dotenv.ignoreIfMissing=true -Djava.io.tmpdir=${project.basedir}/target/tmp</argLine>
                    <!-- Mockito 5 的 inline mock maker 要往临时目录解压 agent jar；
                         本机 %TEMP% 不可写，必须把 java.io.tmpdir 指到 target/tmp -->
                    <systemPropertyVariables>
                        <java.io.tmpdir>${project.basedir}/target/tmp</java.io.tmpdir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!--
              JaCoCo：只做「测量 + 报表」，**不设硬性覆盖率门槛**。

              为什么不设 <check> 门槛：门槛最容易的满足方式是把测试写浅（只断言不抛异常、
              只覆盖 happy path），而不是把代码测对。这个项目的 184 个用例是靠
              「改坏生产代码后测试必须变红」的变异验证培养出来的，
              加一条数字门槛反而会诱导后来的人往反方向走。

              覆盖率的意义在于暴露「一次都没被执行过的代码」——
              jacoco:report 生成的 target/site/jacoco/index.html 里标红的部分，
              是这次改动可能藏着 bug 的地方，比一个总百分比有用得多。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
