{
  "name": "mediquery-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "size": "node -e \"const fs=require('fs');const d='dist/assets';let t=0;for(const f of fs.readdirSync(d)){const s=fs.statSync(d+'/'+f).size;if(f.endsWith('.js')||f.endsWith('.css')){t+=s;console.log((s/1024).toFixed(0).padStart(6)+' KB  '+f)}}console.log('------ total: '+(t/1024).toFixed(0)+' KB')\""
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "pinia": "^2.3.0",
    "axios": "^1.7.9",
    "element-plus": "^2.9.1",
    "@element-plus/icons-vue": "^2.3.1",
    "echarts": "^5.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0",
    "sass": "^1.83.0",
    "unplugin-auto-import": "^0.19.0",
    "unplugin-vue-components": "^0.28.0"
  }
}
